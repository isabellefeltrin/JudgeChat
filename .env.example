# Copie este arquivo para ".env" e preencha. Nunca versione o .env.

# Número de WhatsApp do agente a ser testado (DDI+DDD+número, só dígitos). Opcional:
# se ficar vazio, o programa pergunta a cada execução.
TARGET_NUMBER=5511999999999

# Qual IA gera o cliente simulado e o veredito: claude (padrão) | copilot | codex
AI_PROVIDER=claude


# Só se AI_PROVIDER=codex (API da OpenAI)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Só se AI_PROVIDER=copilot (ajuste de flags/comando do CLI, se necessário)
# COPILOT_CLI_COMMAND=
# COPILOT_CLI_ARGS=
